<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="terminal-root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" fx:controller="com.linuxdesk.ui.LogViewerController">
    <top>
        <VBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="desktop-toolbar">
                <padding>
                    <Insets top="10" right="16" bottom="6" left="16"/>
                </padding>
                <RadioButton fx:id="journalRadio" text="System Journal" selected="true"/>
                <RadioButton fx:id="fileRadio" text="Log File"/>
                <TextField fx:id="pathField" promptText="/var/log/syslog" prefWidth="220" disable="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Start" onAction="#onStart" styleClass="primary-button"/>
                <Button text="Stop" onAction="#onStop" styleClass="secondary-button"/>
                <Button text="Clear" onAction="#onClear" styleClass="secondary-button"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="desktop-toolbar">
                <padding>
                    <Insets top="6" right="16" bottom="10" left="16"/>
                </padding>
                <TextField fx:id="searchField" promptText="Filter loaded lines..." styleClass="field-input" prefWidth="220"/>
                <CheckBox fx:id="autoScrollCheck" text="Auto-scroll" selected="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" styleClass="status-label"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TextArea fx:id="logArea" editable="false" wrapText="false" styleClass="terminal-output"/>
    </center>
</BorderPane>
