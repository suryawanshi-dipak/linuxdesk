<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="desktop-root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" fx:controller="com.linuxdesk.ui.DeployController">
    <top>
        <VBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="desktop-toolbar">
                <padding>
                    <Insets top="10" right="16" bottom="6" left="16"/>
                </padding>
                <Label text="Local" styleClass="field-label"/>
                <TextField fx:id="localPathField" editable="false" promptText="Choose a local folder..."
                           styleClass="field-input" HBox.hgrow="ALWAYS"/>
                <Button text="Browse..." onAction="#onBrowseLocal" styleClass="secondary-button"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="desktop-toolbar">
                <padding>
                    <Insets top="6" right="16" bottom="10" left="16"/>
                </padding>
                <Label text="Remote" styleClass="field-label"/>
                <TextField fx:id="remotePathField" styleClass="field-input" HBox.hgrow="ALWAYS"/>
                <Button fx:id="compareButton" text="Compare" onAction="#onCompare" styleClass="primary-button"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="desktop-toolbar">
                <padding>
                    <Insets top="0" right="16" bottom="10" left="16"/>
                </padding>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" styleClass="status-label"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="diffTable" styleClass="task-table">
            <columns>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                <TableColumn fx:id="pathColumn" text="Path" prefWidth="360"/>
                <TableColumn fx:id="localSizeColumn" text="Local Size" prefWidth="90"/>
                <TableColumn fx:id="remoteSizeColumn" text="Remote Size" prefWidth="90"/>
                <TableColumn fx:id="localModifiedColumn" text="Local Modified" prefWidth="140"/>
                <TableColumn fx:id="remoteModifiedColumn" text="Remote Modified" prefWidth="140"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
