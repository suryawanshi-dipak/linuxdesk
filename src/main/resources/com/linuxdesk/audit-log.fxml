<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane styleClass="desktop-root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" fx:controller="com.linuxdesk.ui.AuditLogController">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="desktop-toolbar">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <TextField fx:id="searchField" promptText="Search..." styleClass="field-input" prefWidth="220"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" styleClass="status-label"/>
            <Button text="Verify Integrity" onAction="#onVerifyIntegrity" styleClass="secondary-button"/>
            <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="auditTable" styleClass="task-table">
            <columns>
                <TableColumn fx:id="timeColumn" text="Time" prefWidth="150"/>
                <TableColumn fx:id="hostColumn" text="Host" prefWidth="150"/>
                <TableColumn fx:id="userColumn" text="User" prefWidth="100"/>
                <TableColumn fx:id="actionColumn" text="Action" prefWidth="260"/>
                <TableColumn fx:id="outcomeColumn" text="Outcome" prefWidth="90"/>
                <TableColumn fx:id="detailColumn" text="Detail" prefWidth="260"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
